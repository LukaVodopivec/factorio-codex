{
  "name": "factorio-codex-monorepo",
  "version": "0.32.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "companion"
  ],
  "scripts": {
    "build": "npm run build -w companion",
    "test": "npm run test:unit && npm run test:mod && npm run test:package",
    "test:unit": "npm run test -w companion",
    "test:mcp": "npm run test:mcp -w companion",
    "typecheck": "npm run typecheck -w companion",
    "package:mod": "bash scripts/package-mod.sh",
    "test:mod": "bash scripts/run-mod-tests.sh",
    "test:package": "bash scripts/package-mod.sh --verify"
  },
  "engines": {
    "node": ">=22"
  }
}

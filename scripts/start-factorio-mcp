#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

if node -e 'process.exit(Number(process.versions.node.split(".")[0]) >= 22 ? 0 : 1)' 2>/dev/null; then
  exec node node_modules/.bin/tsx companion/src/cli.ts mcp
fi

account_home="$(getent passwd "$(id -u)" | cut -d: -f6)"
nvm_root="${NVM_DIR:-$account_home/.nvm}"
node_22=""
for candidate in "$nvm_root"/versions/node/v*/bin/node; do
  if [[ -x "$candidate" ]] && "$candidate" -e 'process.exit(Number(process.versions.node.split(".")[0]) >= 22 ? 0 : 1)' 2>/dev/null; then
    node_22="$candidate"
    break
  fi
done

if [[ -n "$node_22" ]]; then
  exec "$node_22" node_modules/.bin/tsx companion/src/cli.ts mcp
fi

echo "Factorio Codex MCP requires Node 22 or newer; activate it before starting Codex" >&2
exit 1
